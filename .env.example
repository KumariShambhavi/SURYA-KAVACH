# Copy to .env and adjust. All variables are optional (sensible defaults apply).

# Where data/ and the SQLite DB live (recommend a path OUTSIDE OneDrive to avoid sync stalls)
# SOLARFLARE_DATA_DIR=C:\solarflare-data
# SOLARFLARE_DB_PATH=C:\solarflare-data\flare_ops.db

# Auto-ingest scheduler
SOLARFLARE_AUTO_INGEST=1
SOLARFLARE_CHECK_INTERVAL=60

# SoLEXS counts -> GOES flux calibration scale (fittable; see solarflare/calibrate)
# SOLARFLARE_SXR_SCALE=1e-8

# API auth (empty = open). Set to require an X-API-Key header on mutating endpoints.
# SOLARFLARE_API_KEY=change-me

# Notifications (enabled only when set)
# SOLARFLARE_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SOLARFLARE_SMTP_HOST=smtp.example.com
# SOLARFLARE_SMTP_PORT=587
# SOLARFLARE_SMTP_USER=alerts@example.com
# SOLARFLARE_SMTP_PASS=secret
# SOLARFLARE_SMTP_FROM=surya-kavach@example.com
# SOLARFLARE_SMTP_TO=ops1@example.com,ops2@example.com
